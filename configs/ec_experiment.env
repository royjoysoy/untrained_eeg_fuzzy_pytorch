# Environment variables override these defaults. Sourced by jobs in the repo root.
PREPROCESSED_ROOT=${PREPROCESSED_ROOT:-"$base/data/preprocessed_ec_eo"}
EC_DATA_DIR=${EC_DATA_DIR:-"$PREPROCESSED_ROOT/EC"}
PARTICIPANTS=${PARTICIPANTS:-"$EC_DATA_DIR/participants.tsv"}
CNN_VARIANT=${CNN_VARIANT:-eeg}
WEIGHT_SEED=${WEIGHT_SEED:-0}
INPUT_DTYPE=${INPUT_DTYPE:-float32}
SR_REPETITIONS=${SR_REPETITIONS:-5}
SR_SEED_BASE=${SR_SEED_BASE:-1000}
BDI_LOW_MAX=${BDI_LOW_MAX:-6}
BDI_HIGH_MIN=${BDI_HIGH_MIN:-17}
PROBE_C=${PROBE_C:-1.0}
CV_FOLDS=${CV_FOLDS:-5}
CV_REPEATS=${CV_REPEATS:-10}
